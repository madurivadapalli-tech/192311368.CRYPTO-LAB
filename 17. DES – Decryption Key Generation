#include <stdio.h>
#include <stdint.h>

int PC1[56] = {
57,49,41,33,25,17,9,1,58,50,42,34,26,18,
10,2,59,51,43,35,27,19,11,3,60,52,44,36,
63,55,47,39,31,23,15,7,62,54,46,38,30,22,
14,6,61,53,45,37,29,21,13,5,28,20,12,4
};

int PC2[48] = {
14,17,11,24,1,5,3,28,15,6,21,10,
23,19,12,4,26,8,16,7,27,20,13,2,
41,52,31,37,47,55,30,40,51,45,33,48,
44,49,39,56,34,53,46,42,50,36,29,32
};

int shift[16] =
{1,1,2,2,2,2,2,2,1,2,2,2,2,2,2,1};

unsigned long long permute(unsigned long long x,
                            int *table, int n, int input) {
    unsigned long long y = 0;
    int i;

    for (i = 0; i < n; i++)
        y = (y << 1) | ((x >> (input - table[i])) & 1);

    return y;
}

int main() {
    unsigned long long key, temp, C, D, K[16];
    int i, s;

    printf("Enter 16-hex-digit key: ");
    scanf("%llx", &key);

    temp = permute(key, PC1, 56, 64);
    C = temp >> 28;
    D = temp & 0x0FFFFFFF;

    for (i = 0; i < 16; i++) {
        s = shift[i];

        C = ((C << s) | (C >> (28 - s))) & 0x0FFFFFFF;
        D = ((D << s) | (D >> (28 - s))) & 0x0FFFFFFF;

        K[i] = permute((C << 28) | D, PC2, 48, 56);
    }

    printf("Decryption keys:\n");

    for (i = 15; i >= 0; i--)
        printf("K%d = %012llX\n", i + 1, K[i]);

    return 0;
}
