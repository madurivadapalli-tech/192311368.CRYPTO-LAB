#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char text[100], key[27];
    int i, pos;

    printf("Enter 26-letter key: ");
    scanf("%26s", key);

    printf("Enter plaintext: ");
    scanf(" %[^\n]", text);

    for (i = 0; text[i] != '\0'; i++) {
        if (isalpha(text[i])) {
            pos = toupper(text[i]) - 'A';
            text[i] = key[pos];
        }
    }

    printf("Ciphertext: %s\n", text);
    return 0;
}
