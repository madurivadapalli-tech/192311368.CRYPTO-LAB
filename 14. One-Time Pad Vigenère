#include <stdio.h>
#include <string.h>

int main() {
    char p[] = "SENDMOREMONEY";
    char target[] = "CASHNOTNEEDED";
    int key[] = {9,0,1,7,23,15,21,14,11,11,2,8,9};
    int i;

    printf("Plaintext: %s\n", p);

    printf("Ciphertext: ");
    for (i = 0; p[i] != '\0'; i++)
        printf("%c", (p[i] - 'A' + key[i]) % 26 + 'A');

    printf("\n");

    printf("Key for CASHNOTNEEDED: ");
    for (i = 0; target[i] != '\0'; i++)
        printf("%d ", (target[i] - p[i] + 26) % 26);

    printf("\n");

    return 0;
}
