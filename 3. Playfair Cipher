#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

void createMatrix(char key[]) {
    int used[26] = {0}, i, j = 0;
    char ch;

    used['J' - 'A'] = 1;

    for (i = 0; key[i] != '\0'; i++) {
        ch = toupper(key[i]);
        if (ch == 'J') ch = 'I';

        if (ch >= 'A' && ch <= 'Z' && !used[ch - 'A']) {
            matrix[j / 5][j % 5] = ch;
            used[ch - 'A'] = 1;
            j++;
        }
    }

    for (ch = 'A'; ch <= 'Z'; ch++) {
        if (!used[ch - 'A']) {
            matrix[j / 5][j % 5] = ch;
            j++;
        }
    }
}

void find(char ch, int *r, int *c) {
    int i, j;
    if (ch == 'J') ch = 'I';

    for (i = 0; i < 5; i++)
        for (j = 0; j < 5; j++)
            if (matrix[i][j] == ch) {
                *r = i;
                *c = j;
                return;
            }
}

int main() {
    char key[50], text[100], cipher[200];
    int i, n = 0, r1, c1, r2, c2;

    printf("Enter key: ");
    scanf("%49s", key);

    printf("Enter plaintext: ");
    scanf("%99s", text);

    createMatrix(key);

    for (i = 0; text[i] != '\0'; i++) {
        text[i] = toupper(text[i]);
        if (text[i] == 'J') text[i] = 'I';
    }

    for (i = 0; text[i] != '\0'; ) {
        char a = text[i];
        char b;

        if (text[i + 1] == '\0')
            b = 'X';
        else if (text[i + 1] == a)
            b = 'X';
        else
            b = text[i + 1];

        find(a, &r1, &c1);
        find(b, &r2, &c2);

        if (r1 == r2) {
            cipher[n++] = matrix[r1][(c1 + 1) % 5];
            cipher[n++] = matrix[r2][(c2 + 1) % 5];
        } else if (c1 == c2) {
            cipher[n++] = matrix[(r1 + 1) % 5][c1];
            cipher[n++] = matrix[(r2 + 1) % 5][c2];
        } else {
            cipher[n++] = matrix[r1][c2];
            cipher[n++] = matrix[r2][c1];
        }

        if (text[i + 1] == '\0' || text[i + 1] == a)
            i++;
        else
            i += 2;
    }

    cipher[n] = '\0';

    printf("Ciphertext: %s\n", cipher);
    return 0;
}
