#include <stdio.h>

long long gcd(long long a, long long b) {
    while (b != 0) {
        long long t = b;
        b = a % b;
        a = t;
    }
    return a;
}

int main() {
    long long n, m, f;

    printf("Enter n: ");
    scanf("%lld", &n);

    printf("Enter plaintext block: ");
    scanf("%lld", &m);

    f = gcd(n, m);

    if (f > 1)
        printf("Common factor = %lld\n", f);
    else
        printf("No common factor found.\n");

    return 0;
}
