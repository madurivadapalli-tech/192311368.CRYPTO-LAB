#include <stdio.h>
#include <math.h>

int main() {
    double keys = 1;
    int i;

    for (i = 1; i <= 25; i++)
        keys *= i;

    printf("Possible keys = 25! = %.0f\n", keys);
    printf("Approximate power of 2 = 2^%.2f\n", log(keys) / log(2));

    keys /= 25;
    printf("Effectively unique keys = %.0f\n", keys);
    printf("Approximate power of 2 = 2^%.2f\n", log(keys) / log(2));

    return 0;
}
