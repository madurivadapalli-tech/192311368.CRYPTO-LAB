#include <stdio.h>
#include <ctype.h>

int main() {
    char text[200];
    int freq[26] = {0};
    int i, j, max, shift;

    printf("Enter ciphertext: ");
    scanf(" %[^\n]", text);

    for (i = 0; text[i] != '\0'; i++)
        if (isalpha(text[i]))
            freq[toupper(text[i]) - 'A']++;

    printf("Possible plaintexts:\n");

    for (j = 0; j < 10; j++) {
        max = -1;
        shift = 0;

        for (i = 0; i < 26; i++) {
            if (freq[i] > max) {
                max = freq[i];
                shift = i;
            }
        }

        freq[shift] = -1;

        printf("%d. ", j + 1);

        for (i = 0; text[i] != '\0'; i++) {
            if (isalpha(text[i]))
                printf("%c",
                (toupper(text[i]) - shift + 4 + 26) % 26 + 'A');
            else
                putchar(text[i]);
        }

        printf("\n");
    }

    return 0;
}
