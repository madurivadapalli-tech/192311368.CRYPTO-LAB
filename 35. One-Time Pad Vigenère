#include <stdio.h>

int main() {
    char text[100];
    int key[100], n, i;

    printf("Enter plaintext: ");
    scanf("%s", text);

    printf("Enter number of key values: ");
    scanf("%d", &n);

    printf("Enter key values:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &key[i]);

    printf("Ciphertext: ");

    for (i = 0; text[i] != '\0'; i++)
        printf("%c", (text[i] - 'A' + key[i]) % 26 + 'A');

    printf("\n");

    return 0;
}
