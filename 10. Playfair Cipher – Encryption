#include <stdio.h>
#include <ctype.h>

char matrix[5][5] = {
    {'M','F','H','I','K'},
    {'U','N','O','P','Q'},
    {'Z','V','W','X','Y'},
    {'E','L','A','R','G'},
    {'D','S','T','B','C'}
};

void find(char ch, int *r, int *c) {
    int i, j;

    if (ch == 'J')
        ch = 'I';

    for (i = 0; i < 5; i++) {
        for (j = 0; j < 5; j++) {
            if (matrix[i][j] == ch) {
                *r = i;
                *c = j;
                return;
            }
        }
    }
}

int main() {
    char text[100], clean[100];
    int i, j = 0;
    int r1, c1, r2, c2;

    printf("Enter plaintext: ");
    scanf(" %[^\n]", text);

    for (i = 0; text[i] != '\0'; i++) {
        if (isalpha(text[i])) {
            clean[j++] = toupper(text[i]);
        }
    }

    if (j % 2 != 0)
        clean[j++] = 'X';

    clean[j] = '\0';

    printf("Ciphertext: ");

    for (i = 0; i < j; i += 2) {
        find(clean[i], &r1, &c1);
        find(clean[i + 1], &r2, &c2);

        if (r1 == r2) {
            printf("%c%c",
                   matrix[r1][(c1 + 1) % 5],
                   matrix[r2][(c2 + 1) % 5]);
        }
        else if (c1 == c2) {
            printf("%c%c",
                   matrix[(r1 + 1) % 5][c1],
                   matrix[(r2 + 1) % 5][c2]);
        }
        else {
            printf("%c%c",
                   matrix[r1][c2],
                   matrix[r2][c1]);
        }
    }

    printf("\n");

    return 0;
}
