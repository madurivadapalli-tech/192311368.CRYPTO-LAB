#include <stdio.h>

int inverse(int a) {
    int i;
    for (i = 1; i < 26; i++)
        if ((a * i) % 26 == 1)
            return i;
    return -1;
}

int main() {
    char text[200];
    int a = 3, b = 15, inv, i, c, p;

    printf("Enter ciphertext: ");
    scanf(" %[^\n]", text);

    inv = inverse(a);

    for (i = 0; text[i] != '\0'; i++) {
        if (text[i] >= 'A' && text[i] <= 'Z') {
            c = text[i] - 'A';
            p = (inv * (c - b + 26)) % 26;
            text[i] = p + 'A';
        }
    }

    printf("Plaintext: %s\n", text);

    return 0;
}
